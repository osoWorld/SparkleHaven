<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".product.checkout.CheckoutActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/black_fill_circle_shape"
                android:gravity="center"
                android:padding="7dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/back64"
                    app:tint="@color/white" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shipping Details"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textAlignment="center"
                android:layout_weight="1"
                android:fontFamily="@font/cinzel_medium"/>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"/>

        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:id="@+id/addressShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X-421, Eden Orchard"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:id="@+id/cityShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Faisalabad"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="State:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:id="@+id/stateShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Punjab"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone number:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+92 303 6292862"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zip code:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="38000"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Country:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pakistan"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:background="@drawable/black_btn_shape"
            android:text="Change Address"
            android:textAllCaps="false"
            android:layout_marginTop="6dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:layout_gravity="end"
            android:fontFamily="@font/lora_medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/lora_medium"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/paymentMethodCard"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/visa" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visa"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="19sp"
                        android:maxLines="1"
                        android:fontFamily="@font/lora_medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXX-XXXX-XXXX-1234"
                        android:textColor="@color/black"
                        android:layout_marginStart="12dp"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/lora_medium"/>
                    
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Item"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lora_medium"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/invisible_circular_background">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/checkoutCartItemsRecView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Promo Code"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lora_medium"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:padding="14dp"
                    android:background="@drawable/black_circular_filled_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/discount" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#welcome2024"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="21sp"
                        android:maxLines="1"
                        android:fontFamily="@font/lora_medium"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="36dp"
            android:gravity="end"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="Total Price"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:fontFamily="@font/lora_medium"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR."
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/lora_medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="88888888"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/lora_medium"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|bottom">

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_width="140dp"
                    android:layout_height="50dp"
                    android:background="@drawable/black_btn_shape_rounded"
                    android:text="Place Order"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>