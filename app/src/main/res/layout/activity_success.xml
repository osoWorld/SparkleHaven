<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/MainBackgroundStyle"
    tools:context=".success.SuccessActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1"
        android:gravity="center">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="265dp"
            android:layout_height="265dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/success_animation"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Successful !"
            android:layout_marginTop="24dp"
            style="@style/SubHeadingTextStyle"
            android:fontFamily="@font/cinzel_medium"
            android:textSize="24sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You have sucessfully registered in our app and start working on it"
            android:textAlignment="center"
            android:layout_marginHorizontal="45dp"
            android:layout_marginTop="12dp"
            style="@style/DescriptionTextStyle" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/successFinishButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/black_btn_shape"
        android:text="Start Shopping"
        style="@style/RoundedButtonStyle"/>

</LinearLayout>