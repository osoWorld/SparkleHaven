<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/MainBackgroundStyle"
    android:scrollbars="none"
    tools:context=".product.checkout.CheckoutActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/black_fill_circle_shape"
                style="@style/OnBackIconStyle">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/back64" />

            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Shipping Details"
                style="@style/HeadingTextStyle" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name:"
                    android:textStyle="bold"
                    style="@style/DescriptionTextStyle" />

                <TextView
                    android:id="@+id/nameShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    style="@style/DescriptionTextStyle"
                    android:textSize="16sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address:"
                    android:textStyle="bold"
                    style="@style/DescriptionTextStyle"/>

                <TextView
                    android:id="@+id/addressShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    style="@style/DescriptionTextStyle"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City:"
                    android:textStyle="bold"
                    style="@style/DescriptionTextStyle"/>

                <TextView
                    android:id="@+id/cityShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    style="@style/DescriptionTextStyle"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="State:"
                    android:textStyle="bold"
                    style="@style/DescriptionTextStyle"/>

                <TextView
                    android:id="@+id/stateShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    style="@style/DescriptionTextStyle"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone number:"
                    android:textStyle="bold"
                    style="@style/DescriptionTextStyle"/>

                <TextView
                    android:id="@+id/phoneShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    style="@style/DescriptionTextStyle"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zip code:"
                    android:textStyle="bold"
                    style="@style/DescriptionTextStyle"/>

                <TextView
                    android:id="@+id/zipShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    style="@style/DescriptionTextStyle"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Country:"
                    android:textStyle="bold"
                    style="@style/DescriptionTextStyle"/>

                <TextView
                    android:id="@+id/countryShippingDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp"
                    style="@style/DescriptionTextStyle"/>

            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/changeAddressButton"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:background="@drawable/black_btn_shape"
            android:text="Change Address"
            android:layout_marginTop="6dp"
            style="@style/RoundedButtonStyle"
            android:textSize="15sp"
            android:layout_gravity="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method"
            style="@style/SubHeadingTextStyle"
            android:layout_marginTop="10dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/paymentMethodCard"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:cardCornerRadius="14dp"
            style="@style/CardViewStyle"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/visa"
                    app:tint="@null"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="19dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visa"
                        android:maxLines="1"
                        style="@style/SubHeadingTextStyle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XXXX-XXXX-XXXX-1234"
                        android:layout_marginStart="12dp"
                        android:maxLines="1"
                        android:textSize="14sp"
                        style="@style/DescriptionTextStyle"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Item"
            style="@style/SubHeadingTextStyle"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/invisible_circular_background">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/checkoutCartItemsRecView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Promo Code"
            style="@style/SubHeadingTextStyle"
            android:layout_marginTop="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            app:cardCornerRadius="14dp"
            style="@style/CardViewStyle"
            android:layout_marginHorizontal="2dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:padding="12dp"
                    android:background="@drawable/black_circular_filled_bg"
                    style="@style/OnBackIconStyle">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/discount" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#welcome2024"
                        android:textSize="21sp"
                        style="@style/SubHeadingTextStyle"
                        android:maxLines="1" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="36dp"
            android:gravity="end"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Price"
                    style="@style/SubHeadingTextStyle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR."
                        android:textStyle="bold"
                        style="@style/DescriptionTextStyle" />

                    <TextView
                        android:id="@+id/grandPriceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="88888888"
                        android:maxLines="3"
                        style="@style/DescriptionTextStyle"
                        android:ellipsize="end"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|bottom">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/placeOrderButton"
                    android:layout_width="140dp"
                    android:layout_height="50dp"
                    android:background="@drawable/black_btn_shape_rounded"
                    android:text="Place Order"
                    style="@style/MainButtonStyle" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>