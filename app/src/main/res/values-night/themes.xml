<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SparkleHaven" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/Gold_Dark</item>

<!--        <item name="android:background">@color/darkThemeBg</item>-->
        <item name="cardBackgroundColor">@color/cardBackGroundDark</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:textColorHint">@color/Text_OffWhiteDark</item>
        <item name="tint">@color/Text_ColorDark</item>
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="CardViewStyle">
        <item name="cardBackgroundColor">@color/cardBackGroundDark</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">3dp</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="HeadingTextStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/cinzel_medium</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="SubHeadingTextStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:fontFamily">@font/lora_medium</item>
    </style>

    <style name="MainButtonStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/Text_ColorLight</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="android:backgroundTint">@color/cardBackGroundLight</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="RoundedButtonStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/Text_ColorLight</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="android:backgroundTint">@color/cardBackGroundLight</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="OutlinedButtonStyle">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/black_btn_shape_rounded_dark</item>
    </style>

    <style name="OutlinedRoundedButtonStyle">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/white_border</item>
    </style>

    <style name="OnBackIconStyle">
        <item name="android:backgroundTint">@color/cardBackGroundDark</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">7dp</item>
    </style>

    <style name="SearchHintStyle">
        <item name="android:padding">10dp</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:textColorHint">@color/Hint_ColorDark</item>
        <item name="android:inputType">textFilter</item>
        <item name="android:drawableStart">@drawable/search_normal_32</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:background">@drawable/searchbar_background_dark</item>
        <item name="android:drawableTint">@color/Hint_ColorDark</item>
    </style>

    <style name="DescriptionTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:fontFamily">@font/lora_medium</item>
    </style>

    <style name="SmallTextStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="drawableTint">@color/Text_ColorDark</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:maxLines">1</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/Text_ColorDark</item>
        <item name="android:textColorHint">@color/Hint_ColorDark</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <style name="BackgroundTextStyle">
        <item name="android:textColor">@color/darkThemeBg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/cinzel_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="BackgroundTintStyle">
        <item name="tint">@color/darkThemeBg</item>
    </style>

    <style name="ViewStyle">
        <item name="android:background">@color/grey2Light</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="MainBackgroundStyle">
        <item name="android:background">@color/darkThemeBg</item>
    </style>

    <style name="AppbarStyle">
        <item name="android:background">@color/cardBackGroundDark</item>
    </style>

    <style name="ProductImageStyle">
        <item name="android:background">@color/BeigeDark</item>
    </style>

    <style name="ReverseTint">
        <item name="tint">@color/Text_ColorLight</item>
    </style>

    <style name="CardViewStyle2">
        <item name="cardBackgroundColor">@color/darkThemeBg</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="ReverseTextStyle">
        <item name="android:textColor">@color/Text_ColorLight</item>
        <item name="android:fontFamily">@font/lora_medium</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReverseCardViewStyle">
        <item name="cardBackgroundColor">@color/cardBackGroundLight</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">3dp</item>
        <!--        <item name="android:foreground">?android:attr/selectableItemBackground</item>-->
    </style>

    <style name="MaterialSwitchStyle">
        <item name="thumbTint">@color/cardBackGroundDark</item>
    </style>

    <style name="ItemFullCounterStyle">
        <item name="android:backgroundTint">@color/grey2Dark</item>
    </style>

</resources>