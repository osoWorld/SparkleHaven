<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:id="@+id/homeCategoryCV"
    android:layout_height="48dp"
    app:cardCornerRadius="12dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:id="@+id/selectedCategoryLayout"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@drawable/unselected_category"
        android:gravity="center"
        android:padding="10dp">

    <ImageView
        android:id="@+id/homeCategoryImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/anklet"
        android:scaleType="fitXY"
        android:layout_marginHorizontal="8dp"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/homeCategoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accessory"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:layout_marginRight="6dp"
        android:fontFamily="@font/lora_medium"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>