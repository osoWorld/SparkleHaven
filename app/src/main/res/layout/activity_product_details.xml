<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White_Pure"
    tools:context=".product.activities.ProductDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:background="@color/Beige">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/black_fill_circle_shape"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/back64"
                            app:tint="@color/white" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/black_fill_circle_shape"
                    android:gravity="center"
                    android:padding="7dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shopping_bag"
                        app:tint="@color/white" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/pure_gold_couple_ring"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Splended 18 Karat Gold Floral Ring"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="@font/cinzel_medium"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PKR."
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/Black_Pure"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:id="@+id/itemProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="23000"
                    android:layout_marginStart="4dp"
                    android:textSize="15sp"
                    android:textColor="@color/Black_Pure"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 222 Liked"
                    app:drawableStartCompat="@drawable/unfav16"
                    app:drawableTint="@color/black"
                    android:textColor="@color/black"
                    android:layout_weight="1"
                    android:fontFamily="@font/lora_medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available in stock"
                    android:textColor="@color/black"
                    android:layout_weight="1"
                    android:textAlignment="textEnd"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <me.zhanghai.android.materialratingbar.MaterialRatingBar
                    android:layout_width="150dp"
                    android:layout_height="24dp"
                    android:numStars="5"
                    android:stepSize="1"
                    android:progressTint="@color/Gold_Dark"
                    android:backgroundTint="@color/black" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(123 Reviews)"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/lora_medium"/>

            </LinearLayout>
            
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="28dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="30dp"
                    android:gravity="center"
                    android:layout_marginVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size :"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/lora_medium"/>

                    <AutoCompleteTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:inputType="none"
                        android:textColor="@color/black"
                        android:text="17"
                        android:textSize="16sp"
                        android:layout_marginTop="2dp"
                        android:background="@null"
                        android:fontFamily="@font/cinzel_medium"
                        android:textStyle="bold"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:textColor="@color/black"
                android:fontFamily="@font/lora_medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ring_description"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:fontFamily="@font/lora_medium"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/black_outlined_circle_shape"
                        android:gravity="center"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/minus32"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="03"
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/lora_medium"
                        android:textStyle="bold"
                        android:maxLength="2"
                        android:layout_marginHorizontal="14dp"/>

                    <LinearLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/black_fill_circle_shape"
                        android:gravity="center"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/plus32"
                            app:tint="@color/white" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total: PKR."
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/lora_medium"
                        android:textSize="19sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18000000"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/lora_medium"
                        android:textSize="19sp"/>

                </LinearLayout>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="54dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="@color/black">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center">
                    
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/shopping_bag"
                        app:tint="@color/white" />
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add to cart"
                        android:textSize="18sp"
                        android:fontFamily="@font/cinzel_medium"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:layout_marginStart="10dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>